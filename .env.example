# Voice AI Platform Configuration
# Copy this file to .env and fill in your values

# === REQUIRED ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key
DATABASE_URL=postgresql://user:password@localhost:5432/voice_ai

# LLM Provider (pick one or use LiteLLM for multi-provider)
OPENAI_API_KEY=your_openai_key
# OR
DEEPSEEK_API_KEY=your_deepseek_key
# OR
ANTHROPIC_API_KEY=your_anthropic_key

# === OPTIONAL ===
# Secret key for JWT auth
SECRET_KEY=change-me-to-random-string

# Default LLM model
DEFAULT_MODEL=gpt-4o-mini

# Default voice ID (ElevenLabs)
DEFAULT_VOICE_ID=cjVigY5qzO86Huf0OWal

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Stripe (for subscription billing)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Webhook URL for conversation notifications
WEBHOOK_URL=

# Max conversation duration (seconds)
MAX_CONVERSATION_DURATION=600

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
