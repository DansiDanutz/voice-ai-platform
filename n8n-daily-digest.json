{
  "name": "Voice AI - Daily Conversation Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily at 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) as total_conversations, COUNT(DISTINCT visitor_id) as unique_visitors, SUM(message_count) as total_messages, AVG(duration_seconds) as avg_duration FROM conversations WHERE started_at >= NOW() - INTERVAL '24 hours'"
      },
      "id": "fetch-stats",
      "name": "Fetch 24h Stats",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [500, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id, a.name as assistant_name, c.message_count, c.started_at, m.text as last_user_message FROM conversations c JOIN assistants a ON c.assistant_id = a.id LEFT JOIN messages m ON m.conversation_id = c.id AND m.role = 'user' WHERE c.started_at >= NOW() - INTERVAL '24 hours' ORDER BY c.started_at DESC LIMIT 10"
      },
      "id": "fetch-recent",
      "name": "Fetch Recent Conversations",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [500, 500],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Postgres"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.OPENAI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Summarize these voice AI conversation stats into a brief daily digest email. Be concise and highlight key insights.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Stats: {{ JSON.stringify($('Fetch 24h Stats').item.json) }}\\n\\nRecent conversations: {{ JSON.stringify($('Fetch Recent Conversations').all().map(i => i.json)) }}\"\n    }\n  ],\n  \"max_tokens\": 500\n}"
      },
      "id": "generate-summary",
      "name": "AI Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [800, 400]
    },
    {
      "parameters": {
        "sendTo": "={{ $env.OWNER_EMAIL }}",
        "subject": "=🎙️ Voice AI Daily Digest - {{ new Date().toLocaleDateString() }}",
        "emailType": "html",
        "html": "=<h2>🎙️ Voice AI Daily Digest</h2>\n<p>{{ $json.choices[0].message.content.replace(/\\n/g, '<br>') }}</p>\n<hr>\n<p style=\"color:#888;font-size:12px\">Generated by Voice AI Platform • {{ new Date().toISOString() }}</p>"
      },
      "id": "send-email",
      "name": "Email Digest",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1050, 400],
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP"
        }
      }
    }
  ],
  "connections": {
    "Daily at 9 AM": {
      "main": [
        [
          {
            "node": "Fetch 24h Stats",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Recent Conversations",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch 24h Stats": {
      "main": [
        [
          {
            "node": "AI Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Recent Conversations": {
      "main": [
        [
          {
            "node": "AI Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Summary": {
      "main": [
        [
          {
            "node": "Email Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "voice-ai"
    },
    {
      "name": "analytics"
    },
    {
      "name": "email"
    }
  ]
}
